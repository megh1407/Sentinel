      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null
    },
    {
      "name": "producer_service",
      "type": "string"
    },
    {
      "name": "producer_version",
      "type": "string"
    },
    {
      "name": "site_id",
      "type": "string"
    },
    {
      "name": "zone_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "partition_key",
      "type": "string"
    },
    {
      "name": "trace_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "metadata",
      "type": "com.sentinel.common.Metadata"
    },
    {
      "name": "agent_id",
      "type": "string"
    },
    {
      "name": "agent_version",
      "type": "string"
    },
    {
      "name": "input_events",
      "type": {
        "type": "array",
        "items": {
          "type": "string",
          "logicalType": "uuid"
        }
      }
    },
    {
      "name": "result_type",
      "type": "string",
      "default": "maintenance_analysis"
    },
    {
      "name": "confidence",
      "type": "double",
      "doc": "Range [0,1]."
    },
    {
      "name": "processing_time_ms",
      "type": "int"
    },
    {
      "name": "error",
      "type": [
        "null",
        {
          "type": "record",
          "name": "MaintenanceAnalysisError",
          "fields": [
            {
              "name": "code",
              "type": "string"
            },
            {
              "name": "message",
              "type": "string"
            },
            {
              "name": "retryable",
              "type": "boolean"
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "explanation",
      "type": "com.sentinel.common.ExplanationObject",
      "doc": "REQUIRED -- no finding without a populated explanation (Domain Invariant #4; Artifact 7 \u00a78)."
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "MaintenanceAnalysisPayload",
        "fields": [
          {
            "name": "equipment_id",
            "type": "string"
          },
          {
            "name": "risk_score",
            "type": "double",
            "doc": "Range [0,100]."
          },
          {
            "name": "confidence",
            "type": "double",
            "doc": "Range [0,1]."
          },
          {
            "name": "health_index",
            "type": "double",
            "doc": "Range [0,1]."
          },
          {
            "name": "failure_prediction",
            "type": [
              "null",
              {
                "type": "record",
                "name": "FailurePrediction",
                "fields": [
