                    "name": "probability",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null
                  },
                  {
                    "name": "predicted_window_h",
                    "type": [
                      "null",
                      "double"
                    ],
                    "default": null
                  },
                  {
                    "name": "failure_mode",
                    "type": [
                      "null",
                      "string"
                    ],
                    "default": null
                  }
                ]
              }
            ],
            "default": null
          },
          {
            "name": "active_faults",
            "type": {
              "type": "array",
              "items": "string"
            },
            "default": []
          },
          {
            "name": "overdue_tasks",
            "type": {
              "type": "array",
              "items": "string"
            },
            "default": []
          },
