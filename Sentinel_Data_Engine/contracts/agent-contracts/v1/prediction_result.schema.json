{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinel.io/schemas/agent-contracts/v1/prediction_result",
  "title": "PredictionResult",
  "description": "Forward-looking forecast contract — distinct from current risk_score. Used by maintenance failure prediction, environmental dispersion forecasts, and risk trajectory projections. Allows agents to publish 'what happens next' without being mistaken for live risk state.",
  "allOf": [{ "$ref": "./agent_result.schema.json" }],
  "properties": {
    "result_type": { "const": "prediction_result" },
    "payload": {
      "type": "object",
      "required": ["prediction_type","horizon_minutes","probability","predicted_outcome","confidence","generated_at"],
      "properties": {
        "prediction_type":  { "type": "string", "enum": ["equipment_failure","hazard_spread","risk_trajectory","permit_conflict_forecast","worker_exposure"] },
        "horizon_minutes":  { "type": "number", "description": "How far into the future this prediction looks" },
        "probability":      { "type": "number", "minimum": 0, "maximum": 1 },
        "predicted_outcome":{ "type": "string" },
        "predicted_value":  { "type": "number", "description": "Numeric forecast value if applicable, e.g. predicted risk_score" },
        "confidence_interval": { "type": "object", "properties": { "lower": {"type":"number"}, "upper": {"type":"number"} } },
        "contributing_signals": { "type": "array", "items": { "type": "string" } },
        "model_name":       { "type": "string" },
        "model_version":    { "type": "string" },
        "confidence":       { "type": "number", "minimum": 0, "maximum": 1 },
        "generated_at":     { "type": "string", "format": "date-time" }
      }
    }
  }
}
