{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinel.io/schemas/agent-contracts/v1/environment_analysis",
  "title": "EnvironmentAnalysis",
  "allOf": [{ "$ref": "./agent_result.schema.json" }],
  "properties": {
    "result_type": { "const": "environment_analysis" },
    "payload": {
      "type": "object",
      "required": ["risk_score","confidence","hazards","evidence","recommendations","analyzed_at"],
      "properties": {
        "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "hazards": { "type": "array", "items": { "type": "object", "properties": {
          "hazard_type": {"type":"string","enum":["flammable_gas","toxic_gas","oxygen_deficiency","high_temperature","high_pressure","chemical_exposure","radiation"]},
          "measured_value": {"type":"number"}, "unit": {"type":"string"},
          "threshold_ppm": {"type":"number"}, "threshold_breach": {"type":"boolean"},
          "trend": {"type":"string","enum":["rising","stable","falling"]},
          "sensor_ids": {"type":"array","items":{"type":"string"}}
        } } },
        "evacuation_required": { "type": "boolean" },
        "affected_zones":      { "type": "array", "items": { "type": "string" } },
        "evidence":        { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "analyzed_at":     { "type": "string", "format": "date-time" }
      }
    }
  }
}
