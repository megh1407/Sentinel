{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinel.io/schemas/agent-contracts/v1/worker_analysis",
  "title": "WorkerAnalysis",
  "allOf": [{ "$ref": "./agent_result.schema.json" }],
  "properties": {
    "result_type": { "const": "worker_analysis" },
    "payload": {
      "type": "object",
      "required": ["worker_id","risk_score","confidence","safety_status","evidence","recommendations","analyzed_at"],
      "properties": {
        "worker_id":      { "type": "string" },
        "risk_score":     { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence":     { "type": "number", "minimum": 0, "maximum": 1 },
        "safety_status":  { "type": "string", "enum": ["safe","at_risk","in_danger","unresponsive"] },
        "ppe_compliance": { "type": "number", "minimum": 0, "maximum": 1 },
        "ppe_violations": { "type": "array", "items": { "type": "string" } },
        "zone_clearance": { "type": "boolean" },
        "proximity_alerts": { "type": "array", "items": { "type": "object", "properties": { "hazard_type": {"type":"string"}, "distance_m": {"type":"number"}, "safe_distance_m": {"type":"number"} } } },
        "evidence":        { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "analyzed_at":     { "type": "string", "format": "date-time" }
      }
    }
  }
}
