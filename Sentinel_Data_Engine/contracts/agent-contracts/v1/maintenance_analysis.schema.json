{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinel.io/schemas/agent-contracts/v1/maintenance_analysis",
  "title": "MaintenanceAnalysis",
  "allOf": [{ "$ref": "./agent_result.schema.json" }],
  "properties": {
    "result_type": { "const": "maintenance_analysis" },
    "payload": {
      "type": "object",
      "required": ["equipment_id","risk_score","confidence","health_index","evidence","recommendations","analyzed_at"],
      "properties": {
        "equipment_id": { "type": "string" },
        "risk_score":   { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence":   { "type": "number", "minimum": 0, "maximum": 1 },
        "health_index": { "type": "number", "minimum": 0, "maximum": 1 },
        "failure_prediction": { "type": "object", "properties": { "probability": {"type":"number","minimum":0,"maximum":1}, "predicted_window_h": {"type":"number"}, "failure_mode": {"type":"string"} } },
        "active_faults": { "type": "array", "items": { "type": "string" } },
        "overdue_tasks": { "type": "array", "items": { "type": "string" } },
        "evidence":        { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "analyzed_at":     { "type": "string", "format": "date-time" }
      }
    }
  }
}
