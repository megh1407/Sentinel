{
  "type": "record",
  "name": "ActionResult",
  "namespace": "com.sentinel.events.actionresult.v1",
  "doc": "Outcome of an Action's status transition, owned by the Action Context (produced only by the Action Policy Gateway). Action Event category.",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "event_type", "type": "string", "default": "ActionResult"},
    {"name": "event_version", "type": "int", "default": 1},
    {"name": "event_timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "correlation_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "causation_id", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null},
    {"name": "producer_service", "type": "string"},
    {"name": "producer_version", "type": "string"},
    {"name": "site_id", "type": "string"},
    {"name": "zone_id", "type": ["null", "string"], "default": null},
    {"name": "partition_key", "type": "string", "doc": "action_id."},
    {"name": "trace_id", "type": ["null", "string"], "default": null},
    {"name": "metadata", "type": "com.sentinel.common.Metadata"},
    {"name": "payload", "type": {
      "type": "record",
      "name": "ActionResultPayload",
      "fields": [
        {"name": "action_id", "type": "string"},
        {"name": "outcome", "type": {"type": "enum", "name": "ActionOutcome",
          "symbols": ["APPROVED", "REJECTED", "EXECUTED", "FAILED", "EXPIRED"]}},
        {"name": "approved_by", "type": ["null", "string"], "default": null, "doc": "Non-null required when outcome == EXECUTED, unless approved_by == 'policy-gateway-auto' for a whitelisted auto-action."},
        {"name": "executed_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
        {"name": "failure_reason", "type": ["null", "string"], "default": null},
        {"name": "downstream_confirmation", "type": ["null", "string"], "default": null}
      ]
    }}
  ]
}
