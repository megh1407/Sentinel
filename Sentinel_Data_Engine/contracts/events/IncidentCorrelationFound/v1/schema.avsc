{
  "type": "record",
  "name": "IncidentCorrelationFound",
  "namespace": "com.sentinel.events.incidentcorrelationfound.v1",
  "doc": "Published by the Incident Intelligence Agent when it finds similar past incidents. Decision-bearing: explanation REQUIRED.",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "event_type", "type": "string", "default": "IncidentCorrelationFound"},
    {"name": "event_version", "type": "int", "default": 1},
    {"name": "event_timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "correlation_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "causation_id", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null},
    {"name": "producer_service", "type": "string", "default": "incident-intelligence-agent"},
    {"name": "producer_version", "type": "string"},
    {"name": "site_id", "type": "string"},
    {"name": "zone_id", "type": ["null", "string"], "default": null},
    {"name": "partition_key", "type": "string"},
    {"name": "trace_id", "type": ["null", "string"], "default": null},
    {"name": "metadata", "type": "com.sentinel.common.Metadata"},
    {"name": "explanation", "type": "com.sentinel.common.ExplanationObject"},
    {"name": "payload", "type": {
      "type": "record",
      "name": "IncidentCorrelationFoundPayload",
      "fields": [
        {"name": "incident_id", "type": "string"},
        {"name": "correlated_incident_ids", "type": {"type": "array", "items": "string"}},
        {"name": "similarity_scores", "type": {"type": "array", "items": "double"}, "doc": "Parallel array to correlated_incident_ids, each in [0,1]."}
      ]
    }}
  ]
}
