{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinel.io/schemas/config/v1/rule",
  "title": "RuleConfig",
  "description": "Declarative business rules evaluated by agents — gas limits, permit conflict rules, evacuation triggers. Allows safety thresholds to change without code deployment.",
  "type": "object",
  "required": ["rule_id","rule_type","condition","action"],
  "properties": {
    "rule_id":     { "type": "string" },
    "rule_type":   { "type": "string", "enum": ["threshold","conflict","escalation","compliance"] },
    "name":        { "type": "string" },
    "description": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": { "site_ids": {"type":"array","items":{"type":"string"}}, "zone_types": {"type":"array","items":{"type":"string"}} }
    },
    "condition": {
      "type": "object",
      "description": "Structured condition, e.g. { field: 'gas.co_ppm', operator: 'gt', value: 50 }",
      "properties": {
        "field":    { "type": "string" },
        "operator": { "type": "string", "enum": ["gt","gte","lt","lte","eq","neq","in","contains"] },
        "value":    {}
      }
    },
    "action": {
      "type": "object",
      "properties": {
        "action_type": { "type": "string" },
        "severity":    { "type": "string" },
        "parameters":  { "type": "object" }
      }
    },
    "active":   { "type": "boolean", "default": true },
    "version":  { "type": "integer", "default": 1 },
    "effective_from": { "type": "string", "format": "date-time" },
    "owner":    { "type": "string" }
  }
}
