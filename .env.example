# SENTINEL — example environment configuration
#
# Copy to .env and adjust as needed. Every value below is a local-dev
# default already baked into the code as a fallback -- setting these
# only matters if you want something different from local defaults.
# None of these are live-verified against a real deployment; see
# README.md's "Current implementation status" section.

# Event transport: "memory" (default, real local transport, no broker
# needed) or "kafka" (requires a reachable broker).
SENTINEL_TRANSPORT=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API gateway CORS boundary (not authentication -- see README.md's
# "Security / deployment caveats"). "development" (default) allows all
# origins. "production" requires SENTINEL_ALLOWED_ORIGINS to be set, or
# the service refuses to start.
SENTINEL_ENVIRONMENT=development
SENTINEL_ALLOWED_ORIGINS=

# Redis (used by zone_intelligence_agent and the API gateway's state cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Postgres (used by zone_intelligence_agent's history/audit repositories)
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentinel
SENTINEL_DB_USER=postgres
SENTINEL_DB_PASSWORD=postgres
SENTINEL_DEMO_POSTGRES_DSN=postgresql+psycopg2://postgres:localdev@localhost:5432/sentinel

# Neo4j (topology reasoning -- code exists, never live-tested against a
# running instance anywhere in this repository's history)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# Qdrant (vector search -- storage/retrieval code exists; embeddings are
# currently a deterministic-hash placeholder, not real semantic vectors)
QDRANT_URL=http://localhost:6333

# Gemini / Safety Copilot (optional -- natural-language explanations
# only; never influences risk score, severity, decision, or escalation).
# Leave unset to run entirely on the deterministic fallback explanation.
GEMINI_API_KEY=
GEMINI_MODEL=

# Worker Safety Agent: optional JSON object mapping zone_id -> required
# PPE item list. Leave unset to use the agent's built-in defaults.
WORKER_SAFETY_REQUIRED_PPE=
