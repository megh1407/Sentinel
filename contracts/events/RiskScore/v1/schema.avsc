{
  "type": "record",
  "name": "RiskScore",
  "namespace": "com.sentinel.events.riskscore.v1",
  "doc": "The core explainable output of the Risk Engine, owned by the Risk Context. Intelligence Event category. Decision-bearing: explanation is REQUIRED, never null.",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "event_type", "type": "string", "default": "RiskScore"},
    {"name": "event_version", "type": "int", "default": 1},
    {"name": "event_timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "correlation_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "causation_id", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null},
    {"name": "producer_service", "type": "string"},
    {"name": "producer_version", "type": "string"},
    {"name": "site_id", "type": "string"},
    {"name": "zone_id", "type": ["null", "string"], "default": null, "doc": "Null only for an explicit site-wide aggregate score."},
    {"name": "partition_key", "type": "string", "doc": "zone_id if present, else site_id."},
    {"name": "trace_id", "type": ["null", "string"], "default": null},
    {"name": "metadata", "type": "com.sentinel.common.Metadata"},
    {"name": "explanation", "type": "com.sentinel.common.ExplanationObject", "doc": "REQUIRED -- a RiskScore may never be published without a populated explanation (Domain Invariant #4)."},
    {"name": "payload", "type": {
      "type": "record",
      "name": "RiskScorePayload",
      "fields": [
        {"name": "risk_id", "type": "string"},
        {"name": "score", "type": "double", "doc": "In [0,100]."},
        {"name": "risk_level", "type": {"type": "enum", "name": "RiskScoreLevel",
          "symbols": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "LOCKDOWN"]}},
        {"name": "contributing_agent_result_ids", "type": {"type": "array", "items": "string"}, "default": []},
        {"name": "compound_rules_fired", "type": {"type": "array", "items": "string"}, "default": [],
          "doc": "rule_id values of any CompoundRule that fired and potentially overrode the band floor."},
        {"name": "valid_until", "type": {"type": "long", "logicalType": "timestamp-millis"}},
        {"name": "affected_zones", "type": {"type": "array", "items": "string"}, "default": [],
          "doc": "Additive v1 field (non-breaking). Zones implicated by cross-zone/propagation analysis, beyond zone_id itself. Empty means not populated, not confirmed absent."},
        {"name": "affected_assets", "type": {"type": "array", "items": "string"}, "default": [],
          "doc": "Additive v1 field (non-breaking). Equipment/asset ids implicated alongside this risk."},
        {"name": "human_exposure_confirmed", "type": "boolean", "default": false,
          "doc": "Additive v1 field (non-breaking). True only when worker-presence/exposure has been positively confirmed for this risk."},
        {"name": "critical_controls_unavailable", "type": {"type": "array", "items": "string"}, "default": [],
          "doc": "Additive v1 field (non-breaking). Names of critical safety controls known to be unavailable."},
        {"name": "propagation_paths", "type": {"type": "array", "items": "string"}, "default": [],
          "doc": "Additive v1 field (non-breaking). 'from_zone->to_zone' edges from cross-zone interaction analysis."},
        {"name": "cascade_paths", "type": {"type": "array", "items": "string"}, "default": [],
          "doc": "Additive v1 field (non-breaking). Full 'zone_a->zone_b->zone_c' cascade chains, earliest node first."},
        {"name": "decision_category", "type": "string", "default": "",
          "doc": "Additive v1 field (non-breaking). Verbatim mirror of risk_orchestrator_agent's DecisionCategory enum value."},
        {"name": "escalation_required", "type": "boolean", "default": false,
          "doc": "Additive v1 field (non-breaking). Verbatim mirror of SystemRiskAssessment.escalation_required."},
        {"name": "manual_review_required", "type": "boolean", "default": false,
          "doc": "Additive v1 field (non-breaking). Verbatim mirror of SystemRiskAssessment.manual_review_required."},
        {"name": "analysis_completeness", "type": "string", "default": "complete",
          "doc": "Additive v1 field (non-breaking). 'complete' | 'partial', verbatim mirror of GlobalRiskScore.analysis_completeness."},
        {"name": "missing_domains", "type": {"type": "array", "items": "string"}, "default": [],
          "doc": "Additive v1 field (non-breaking). Verbatim mirror of GlobalRiskScore.missing_domains."}
      ]
    }}
  ]
}
