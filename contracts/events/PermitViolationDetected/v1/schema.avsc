{
  "type": "record",
  "name": "PermitViolationDetected",
  "namespace": "com.sentinel.events.permitviolationdetected.v1",
  "doc": "Published by the Permit Intelligence Agent when a permit rule is violated. Decision-bearing: explanation REQUIRED.",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "event_type", "type": "string", "default": "PermitViolationDetected"},
    {"name": "event_version", "type": "int", "default": 1},
    {"name": "event_timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "correlation_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "causation_id", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null},
    {"name": "producer_service", "type": "string", "default": "permit-intelligence-agent"},
    {"name": "producer_version", "type": "string"},
    {"name": "site_id", "type": "string"},
    {"name": "zone_id", "type": "string"},
    {"name": "partition_key", "type": "string"},
    {"name": "trace_id", "type": ["null", "string"], "default": null},
    {"name": "metadata", "type": "com.sentinel.common.Metadata"},
    {"name": "explanation", "type": "com.sentinel.common.ExplanationObject"},
    {"name": "payload", "type": {
      "type": "record",
      "name": "PermitViolationDetectedPayload",
      "fields": [
        {"name": "permit_id", "type": "string"},
        {"name": "violation_type", "type": {"type": "enum", "name": "PermitViolationType",
          "symbols": ["EXPIRED_BUT_ACTIVE", "UNAUTHORIZED_ACCESS", "CONFLICTING_PERMITS", "CONDITION_VIOLATED"]}}
      ]
    }}
  ]
}
