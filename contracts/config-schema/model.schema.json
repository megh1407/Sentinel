{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinel.io/schemas/config/v1/model",
  "title": "ModelConfig",
  "description": "ML/AI model registry entry. Tracks which model version each agent uses, for reproducibility and rollback.",
  "type": "object",
  "required": ["model_id","model_type","version","status"],
  "properties": {
    "model_id":    { "type": "string" },
    "model_type":  { "type": "string", "enum": ["classification","regression","forecasting","embedding","llm","anomaly_detection"] },
    "version":     { "type": "string" },
    "status":      { "type": "string", "enum": ["staging","canary","production","deprecated","retired"] },
    "owner_agent": { "type": "string", "description": "agent_id from agent-registry that uses this model" },
    "training_data_ref": { "type": "string" },
    "performance_metrics": {
      "type": "object",
      "properties": {
        "accuracy": {"type":"number"}, "precision": {"type":"number"},
        "recall": {"type":"number"}, "f1": {"type":"number"},
        "auc": {"type":"number"}, "evaluated_at": {"type":"string","format":"date-time"}
      }
    },
    "rollback_to": { "type": "string", "description": "Previous model_id to revert to if this model underperforms" },
    "deployed_at": { "type": "string", "format": "date-time" },
    "canary_traffic_pct": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
