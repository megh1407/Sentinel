{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinel.io/schemas/agent-contracts/v1/agent_result",
  "title": "AgentResult",
  "description": "Universal output envelope every SENTINEL agent MUST wrap its result in.",
  "allOf": [{ "$ref": "../../events/v1/base_event.schema.json" }],
  "required": ["agent_id","agent_version","input_events","result_type","confidence","processing_time_ms","explanation","payload"],
  "properties": {
    "agent_id":           { "type": "string" },
    "agent_version":      { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "input_events":       { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "result_type":        { "type": "string" },
    "confidence":         { "type": "number", "minimum": 0, "maximum": 1 },
    "processing_time_ms": { "type": "integer", "minimum": 0 },
    "error":              { "type": "object", "properties": { "code": {"type":"string"}, "message": {"type":"string"}, "retryable": {"type":"boolean"} } },
    "explanation": {
      "type": "object",
      "description": "Mandatory 'why' for this result, mirroring Layer 0's ExplanationObject (contracts/common/ExplanationObject.avsc). No agent may emit a finding without a populated explanation.",
      "required": ["summary","confidence","evidence","generated_at"],
      "properties": {
        "summary":    { "type": "string", "description": "One-sentence, deterministically-reconstructable human-readable explanation." },
        "confidence": {
          "type": "object",
          "description": "Mirrors Layer 0's ConfidenceScore.",
          "required": ["value","derivation"],
          "properties": {
            "value":          { "type": "number", "minimum": 0, "maximum": 1 },
            "derivation":     { "type": "string", "enum": ["RULE_BASED","MODEL_BASED","COMPOSITE"] },
            "model_name":     { "type": ["string","null"], "default": null },
            "model_version":  { "type": ["string","null"], "default": null },
            "rule_id":        { "type": ["string","null"], "default": null },
            "rule_version":   { "type": ["integer","null"], "default": null }
          }
        },
        "evidence": {
          "type": "array",
          "description": "Non-empty whenever the parent finding is not NO_FINDING. Mirrors Layer 0's EvidenceItem.",
          "items": {
            "type": "object",
            "required": ["source_event_id","source_type","description","weight","timestamp"],
            "properties": {
              "source_event_id": { "type": "string" },
              "source_type":     { "type": "string" },
              "description":     { "type": "string" },
              "weight":          { "type": "number", "minimum": 0, "maximum": 1 },
              "timestamp":       { "type": "string", "format": "date-time" }
            }
          }
        },
        "reasoning_steps":  { "type": "array", "items": { "type": "string" }, "default": [] },
        "risk_contributors": {
          "type": "array",
          "description": "Empty for non-risk-scoring explanations. Mirrors Layer 0's RiskContributor.",
          "default": [],
          "items": {
            "type": "object",
            "required": ["factor_name","contribution_score","description"],
            "properties": {
              "factor_name":        { "type": "string" },
              "contribution_score": { "type": "number", "minimum": 0, "maximum": 100 },
              "description":        { "type": "string" },
              "source_event_id":    { "type": ["string","null"], "default": null }
            }
          }
        },
        "rule_metadata": { "type": ["object","null"], "additionalProperties": { "type": "string" }, "default": null },
        "generated_at":  { "type": "string", "format": "date-time", "description": "Always <= the parent event's event_timestamp." }
      }
    },
    "payload":            { "type": "object" }
  }
}
